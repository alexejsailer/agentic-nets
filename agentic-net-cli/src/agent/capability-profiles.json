{
  "schemaVersion": "2.0",
  "description": "Canonical capability catalog. Owned by core/agentic-net-master; the CLI copy at agentic-nets/agentic-net-cli/src/agent/capability-profiles.json is synced verbatim via `npm run sync-tools`. Both loaders hard-assert schemaVersion, so a skewed copy fails at startup.",
  "constants": {
    "contextBudget": {
      "defaultMaxChars": 12000,
      "minChars": 2000,
      "maxChars": 64000,
      "defaultMaxItemsPerStore": 12,
      "minItemsPerStore": 1,
      "maxItemsPerStore": 100,
      "defaultMaxValueLength": 1500,
      "minValueLength": 128,
      "maxValueLength": 8000,
      "charsPerToken": 4
    },
    "scopeRank": [
      "task",
      "agent",
      "session",
      "model"
    ],
    "hierarchy": {
      "readPolicies": [
        "local-first",
        "local-only",
        "parent-first"
      ],
      "resolutions": [
        "nearest",
        "explicit",
        "merge"
      ],
      "nearestDepth": 1,
      "mergeDepth": 5,
      "childToParentRelations": [
        "part-of",
        "inherits-context",
        "parent-context"
      ],
      "parentToChildRelations": [
        "contains",
        "context-inherited-by",
        "child-context"
      ]
    },
    "semverCases": [
      {
        "constraint": "*",
        "actual": null,
        "matches": true
      },
      {
        "constraint": null,
        "actual": "1.0.0",
        "matches": true
      },
      {
        "constraint": "^1.0.0",
        "actual": "1.0.0",
        "matches": true
      },
      {
        "constraint": "^1.0.0",
        "actual": "1.1.0",
        "matches": true
      },
      {
        "constraint": "^1.0.0",
        "actual": "2.0.0",
        "matches": false
      },
      {
        "constraint": "^1.2.0",
        "actual": "1.1.9",
        "matches": false
      },
      {
        "constraint": "^0.3.0",
        "actual": "0.3.9",
        "matches": true
      },
      {
        "constraint": "^0.3.0",
        "actual": "0.4.0",
        "matches": false
      },
      {
        "constraint": "^0.0.7",
        "actual": "0.0.7",
        "matches": true
      },
      {
        "constraint": "^0.0.7",
        "actual": "0.0.8",
        "matches": false
      },
      {
        "constraint": "~1.2.0",
        "actual": "1.2.9",
        "matches": true
      },
      {
        "constraint": "~1.2.0",
        "actual": "1.3.0",
        "matches": false
      },
      {
        "constraint": "~1.2.4",
        "actual": "1.2.3",
        "matches": false
      },
      {
        "constraint": "1.2.3",
        "actual": "1.2.3",
        "matches": true
      },
      {
        "constraint": "1.2.3",
        "actual": "1.2.4",
        "matches": false
      },
      {
        "constraint": "authored",
        "actual": "authored",
        "matches": true
      },
      {
        "constraint": "authored",
        "actual": "1.0.0",
        "matches": false
      },
      {
        "constraint": "^1.0.0",
        "actual": "bootstrapped",
        "matches": false
      }
    ]
  },
  "toolTargets": {
    "description": "Exhaustive resource classification for enforcement. Every tool in either runtime's registry MUST appear in exactly one group (pinned by tests both sides). read/write: single place target extracted via placeParams, checked against resourceScopes read/writePlaces and the context capsule's binding/access gates. link: multi-endpoint place writes via linkParams (+ optional context sessionId). contextSession: targets an installed context session. structural: mutation with no pre-determinable place target \u2014 denied outright whenever a writePlaces restriction is active (a place-scoped grant does not include structural mutations). ambient: no resource target; only the ambient session scope applies.",
    "placeParams": [
      "placeId",
      "placePath",
      "place"
    ],
    "linkParams": [
      "from",
      "to",
      "fromPlaceId",
      "toPlaceId"
    ],
