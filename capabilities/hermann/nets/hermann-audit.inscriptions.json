[
  {
    "action": {
      "template": {
        "at": "${now()}",
        "reason": "weekly",
        "repoId": "${repo.data.repoId}",
        "sha": ""
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "req"
      }
    ],
    "id": "t-hermann-audit-cron",
    "kind": "map",
    "label": "Weekly audit (Monday 06:30)",
    "metadata": {
      "netId": "hermann-audit",
      "sessionId": "agent-hermann"
    },
    "mode": "SINGLE",
    "postsets": {
      "req": {
        "host": "hermann@agentic-net-node:8080",
        "placeId": "p-hermann-audit-request"
      }
    },
    "presets": {
      "repo": {
        "arcql": "FROM $ WHERE $.status == \"bootstrapped\" LIMIT 1",
        "consume": false,
        "host": "hermann@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-hermann-repo",
        "take": "FIRST"
      }
    },
    "schedule": {
      "cron": "0 30 6 * * MON",
      "timezone": "Europe/Berlin",
      "type": "cron"
    }
  },
  {
    "action": {
      "template": {
        "args": {
          "argv": [
            "digest",
            "${req.data.sha}",
            "${repo.data.repoId}"
          ],
          "env": {
            "MODEL_ID": "hermann"
          },
          "timeoutMs": 600000,
          "toolId": "hermann-digest"
        },
        "command": "invoke",
        "executor": "script",
        "expect": "text",
        "filedAt": "${now()}",
        "id": "digest-${now()}",
        "kind": "command",
        "reason": "${req.data.reason}",
        "stage": "digest"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "cmd"
      }
    ],
    "id": "t-hermann-audit-prep",
    "kind": "map",
    "label": "Audit request to digest command",
    "metadata": {
      "netId": "hermann-audit",
      "sessionId": "agent-hermann"
    },
    "mode": "SINGLE",
    "postsets": {
      "cmd": {
        "host": "hermann@agentic-net-node:8080",
        "placeId": "p-hermann-audit-cmd"
      }
    },
    "presets": {
      "repo": {
        "arcql": "FROM $ WHERE $.status == \"bootstrapped\" LIMIT 1",
        "consume": false,
        "host": "hermann@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-hermann-repo",
        "take": "FIRST"
      },
      "req": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "hermann@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-hermann-audit-request",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "await": "ALL",
      "dispatch": [
        {
          "channel": "default",
          "executor": "bash"
        }
      ],
      "executorId": "agentic-net-executor-default",
      "groupBy": "executor",
      "inputPlace": "input",
      "timeoutMs": 600000,
      "type": "command"
    },
    "description": "Measures the repository once per audit (tree, pom, resources, Dockerfile, compose, tests, migrations, commits) and queues the twelve factor checks.",
    "emit": [
      {
        "from": "@result",
        "to": "log"
      }
    ],
    "id": "t-hermann-digest-cmd",
    "kind": "command",
    "label": "Repository digest",
    "metadata": {
      "netId": "hermann-audit",
      "sessionId": "agent-hermann"
    },
    "mode": "SINGLE",
    "postsets": {
      "digest": {
        "host": "hermann@agentic-net-node:8080",
        "placeId": "p-hermann-repo-digest"
      },
      "factor_cmd": {
        "host": "hermann@agentic-net-node:8080",
        "placeId": "p-hermann-factor-cmd"
      },
      "log": {
        "host": "hermann@agentic-net-node:8080",
        "placeId": "p-hermann-audit-log",
        "retain": 300
      }
    },
    "presets": {
      "input": {
        "arcql": "FROM $ WHERE $.stage == \"digest\" LIMIT 1",
        "consume": true,
        "host": "hermann@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-hermann-audit-cmd",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "await": "ALL",
      "dispatch": [
        {
          "channel": "default",
          "executor": "bash"
        }
      ],
      "executorId": "agentic-net-executor-default",
      "groupBy": "executor",
      "inputPlace": "input",
      "timeoutMs": 900000,
      "type": "command"
    },
    "emit": [
      {
        "from": "@result",
        "to": "log"
      }
    ],
