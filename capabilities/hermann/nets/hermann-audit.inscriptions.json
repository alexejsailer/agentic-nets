    "id": "t-hermann-scorecard-cmd",
    "kind": "command",
    "label": "Scorecard",
    "metadata": {
      "netId": "hermann-audit",
      "sessionId": "agent-hermann"
    },
    "mode": "SINGLE",
    "postsets": {
