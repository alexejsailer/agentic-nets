            "RESPONSE_TEXT": "${resp.data.text}"
          },
          "timeoutMs": 300000,
          "toolId": "hermann-context"
        },
        "command": "invoke",
        "executor": "script",
        "expect": "text",
        "filedAt": "${now()}",
        "id": "ctx-spec-${now()}",
        "iterationId": "${resp.data.iterationId}",
        "kind": "command",
        "promptId": "${resp.data.promptId}",
        "stage": "spec"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "cmd"
      }
    ],
    "id": "t-hermann-answer-prep",
    "kind": "map",
    "label": "Answer to spec brief",
    "metadata": {
      "netId": "hermann-spec",
      "sessionId": "agent-hermann"
