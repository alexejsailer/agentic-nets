  {
    "action": {
      "allowedTools": [],
      "answerSchema": {
        "required": [
          "specId",
          "iterationId",
          "promptId",
          "title",
          "summary",
          "story",
          "acceptance",
          "api",
          "data",
          "config",
          "factors",
          "tests",
          "outOfScope",
          "status"
        ],
        "retries": 1,
        "types": {
          "acceptance": "array",
          "api": "array",
          "config": "array",
          "data": "array",
          "factors": "array",
          "outOfScope": "array",
          "tests": "array",
          "title": "string"
        }
      },
      "autoEmit": true,
      "maxIterations": 1,
      "modelId": "hermann",
      "nl": "You are Hermann, writing the spec for the iteration the person chose. Read the brief, then reply with ONE JSON object and nothing else. The spec is the contract the coder implements and the reviewer checks: every acceptance criterion must be testable; configuration comes from environment variables; schema changes are versioned Flyway migrations; the whole spec fits one pull request.\n\n${ctx.data.brief}\n\nReply with exactly this shape: {\"specId\": \"<specId from the brief>\", \"iterationId\": \"<iterationId from the brief>\", \"promptId\": \"<promptId from the brief>\", \"title\": \"<imperative, under 70 characters>\", \"summary\": \"<three sentences>\", \"story\": \"As a <user>, I want <capability>, so that <value>.\", \"acceptance\": [\"Given ..., when ..., then ...\"], \"api\": [\"<METHOD /path: request, response, status codes>\"], \"data\": [\"<table or entity change and its migration name>\"], \"config\": [{\"name\": \"ENV_NAME\", \"purpose\": \"...\", \"default\": \"...\"}], \"factors\": [\"<factor number: how it is touched>\"], \"tests\": [\"<test class: what it proves>\"], \"outOfScope\": [\"...\"], \"risks\": [\"...\"], \"status\": \"draft\", \"at\": \"<now from the brief>\"}",
      "oneShot": true,
      "role": "r",
      "sessionId": "agent-hermann",
      "tier": "medium",
      "type": "agent"
    },
    "emit": [
      {
        "from": "@response",
        "to": "specs",
        "when": "status == 'draft'"
      },
      {
        "from": "@response",
        "to": "errors",
        "when": "status != 'draft'"
      },
      {
        "from": "@response",
        "to": "errors",
        "when": "error"
      }
    ],
    "id": "t-hermann-spec",
    "kind": "agent",
    "label": "Write the spec",
    "metadata": {
      "netId": "hermann-spec",
      "sessionId": "agent-hermann"
    },
    "mode": "SINGLE",
    "postsets": {
      "errors": {
        "host": "hermann@agentic-net-node:8080",
        "placeId": "p-hermann-llm-errors",
        "retain": 100
      },
      "specs": {
        "host": "hermann@agentic-net-node:8080",
        "placeId": "p-hermann-specs"
      }
    },
    "presets": {
      "ctx": {
        "arcql": "FROM $ WHERE $.purpose == \"spec\" LIMIT 1",
        "consume": true,
        "host": "hermann@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-hermann-context",
        "reservationTtlMs": 600000,
        "take": "FIRST"
