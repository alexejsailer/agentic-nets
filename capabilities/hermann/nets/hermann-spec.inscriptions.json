    "id": "t-hermann-revise-prep",
    "kind": "map",
    "label": "Reshaped question to a new proposal brief",
    "metadata": {
      "netId": "hermann-spec",
      "sessionId": "agent-hermann"
    },
    "mode": "SINGLE",
    "postsets": {
