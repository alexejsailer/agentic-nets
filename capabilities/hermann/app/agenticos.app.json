{
  "name": "hermann",
  "displayName": "Hermann",
  "version": "0.1.0",
  "description": "Drive Hermann, the twelve-factor Spring Boot developer: set the goal and the architecture principles, answer his proposals (a choice, an interview or a goal definition) each iteration, approve specs, merge pull requests, and watch the scorecard, the runs and the journal.",
  "author": "AgenticNetOS",
  "tags": ["application", "developer", "twelve-factor", "hermann"],
  "visibility": "public",
  "ui": {"element": "agenticos-hermann-v1", "entryFile": "ui/main.mjs", "sdkVersion": "^0.1.0", "isolation": "trusted-element"},
  "application": {
    "scope": "model",
    "instancePolicy": "singleton",
    "surface": {"route": "hermann", "icon": "build", "defaultView": "stores"},
    "stores": [
      {"role": "config", "placeId": "p-hermann-config", "required": true, "description": "Hermann's configuration (newest token wins)."},
      {"role": "goal", "placeId": "p-hermann-goal", "required": true, "description": "The overall goal, principles and constraints (newest token wins)."},
      {"role": "adr", "placeId": "p-hermann-adr", "required": true, "description": "Architecture decision records (newest token per adrId wins)."},
      {"role": "cards", "placeId": "p-hermann-cards", "required": true, "description": "The twelve factor cards."},
      {"role": "infra", "placeId": "p-hermann-infra", "required": true, "description": "Infrastructure health measurements."},
      {"role": "repo", "placeId": "p-hermann-repo", "required": true, "description": "The service repository record."},
      {"role": "iterate", "placeId": "p-hermann-iterate", "required": true, "description": "Iteration triggers."},
      {"role": "prompts", "placeId": "p-hermann-prompts", "required": true, "description": "Hermann's questions: choices, interviews, goal requests."},
      {"role": "responses", "placeId": "p-hermann-responses", "required": true, "description": "The person's answers."},
      {"role": "specs", "placeId": "p-hermann-specs", "required": true, "description": "Specs."},
      {"role": "decisions", "placeId": "p-hermann-decisions", "required": true, "description": "Spec approvals, merges, change requests."},
      {"role": "runs", "placeId": "p-hermann-runs", "required": true, "description": "Coder runs: branch, pull request, tests."},
      {"role": "verification", "placeId": "p-hermann-verification", "required": true, "description": "Verification results."},
      {"role": "reviews", "placeId": "p-hermann-reviews", "required": true, "description": "Review verdicts."},
      {"role": "scorecard", "placeId": "p-hermann-scorecard", "required": true, "description": "Twelve-factor scorecards per commit."},
      {"role": "reports", "placeId": "p-hermann-factor-reports", "required": true, "description": "Factor reports with evidence."},
      {"role": "journal", "placeId": "p-hermann-journal", "required": true, "description": "What every lane did."},
      {"role": "errors", "placeId": "p-hermann-errors", "required": true, "description": "Script errors."},
      {"role": "llm-errors", "placeId": "p-hermann-llm-errors", "required": true, "description": "Answers that missed their contract."},
      {"role": "setup-cmd", "placeId": "p-hermann-setup-cmd", "required": true, "description": "Setup commands (health, provision, bootstrap)."},
      {"role": "audit-request", "placeId": "p-hermann-audit-request", "required": true, "description": "Audit requests."}
    ],
    "actions": [
      {"name": "start-iteration", "targetRole": "iterate", "description": "Ask Hermann what the next iteration should be.",
       "defaults": {"reason": "app", "requestedBy": "app"}, "guard": {"role": "iterate", "matchKey": "iterationId", "exists": false},
       "inputSchema": {"type": "object", "required": ["iterationId", "at"], "properties": {"iterationId": {"type": "string"}, "at": {"type": "string"}}}},
      {"name": "respond", "targetRole": "responses", "description": "Answer, reshape or reject one of Hermann's questions.",
       "defaults": {"by": "app"}, "guard": {"role": "responses", "matchKey": "promptId", "exists": false},
       "inputSchema": {"type": "object", "required": ["promptId", "iterationId", "intent", "at"], "properties": {"promptId": {"type": "string"}, "iterationId": {"type": "string"}, "intent": {"type": "string"}, "selected": {"type": "array", "items": {"type": "string"}}, "text": {"type": "string"}, "notes": {"type": "string"}, "at": {"type": "string"}}}},
      {"name": "approve-spec", "targetRole": "decisions", "description": "Approve a draft spec; the coder starts.",
       "defaults": {"kind": "spec-approval", "verdict": "approved", "by": "app"}, "guard": {"role": "decisions", "matchKey": "specId", "exists": false},
       "inputSchema": {"type": "object", "required": ["specId", "at"], "properties": {"specId": {"type": "string"}, "notes": {"type": "string"}, "at": {"type": "string"}}}},
      {"name": "reject-spec", "targetRole": "decisions", "description": "Reject a draft spec with a reason.",
       "defaults": {"kind": "spec-approval", "verdict": "rejected", "by": "app"}, "guard": {"role": "decisions", "matchKey": "specId", "exists": false},
       "inputSchema": {"type": "object", "required": ["specId", "at"], "properties": {"specId": {"type": "string"}, "notes": {"type": "string"}, "at": {"type": "string"}}}},
      {"name": "merge", "targetRole": "decisions", "description": "Merge a verified pull request; Hermann tags, audits and starts the next iteration.",
       "defaults": {"kind": "merge", "verdict": "merge", "by": "app"}, "guard": {"role": "decisions", "matchKey": "runId", "exists": false, "where": {"verdict": "merge"}},
       "inputSchema": {"type": "object", "required": ["runId", "at"], "properties": {"runId": {"type": "string"}, "notes": {"type": "string"}, "at": {"type": "string"}}}},
      {"name": "request-changes", "targetRole": "decisions", "description": "Send a run back to the coder with your notes.",
       "defaults": {"kind": "merge", "verdict": "changes", "by": "app"},
       "inputSchema": {"type": "object", "required": ["runId", "at"], "properties": {"runId": {"type": "string"}, "notes": {"type": "string"}, "at": {"type": "string"}}}},
      {"name": "set-goal", "targetRole": "goal", "description": "Define or update the overall goal, principles and constraints.",
       "defaults": {"goalId": "g-1", "status": "defined"},
       "inputSchema": {"type": "object", "required": ["title", "description", "updatedAt"], "properties": {"title": {"type": "string"}, "description": {"type": "string"}, "principles": {"type": "array", "items": {"type": "string"}}, "constraints": {"type": "array", "items": {"type": "string"}}, "updatedAt": {"type": "string"}}}},
      {"name": "add-adr", "targetRole": "adr", "description": "Propose an architecture decision record.",
       "defaults": {"status": "proposed"}, "guard": {"role": "adr", "matchKey": "adrId", "exists": false},
       "inputSchema": {"type": "object", "required": ["adrId", "title", "decision", "updatedAt"], "properties": {"adrId": {"type": "string"}, "title": {"type": "string"}, "context": {"type": "string"}, "decision": {"type": "string"}, "consequences": {"type": "string"}, "updatedAt": {"type": "string"}}}},
      {"name": "decide-adr", "targetRole": "adr", "description": "Accept, reject or supersede an architecture decision record (writes a new version).",
       "inputSchema": {"type": "object", "required": ["adrId", "title", "decision", "status", "updatedAt"], "properties": {"adrId": {"type": "string"}, "title": {"type": "string"}, "context": {"type": "string"}, "decision": {"type": "string"}, "consequences": {"type": "string"}, "status": {"type": "string"}, "updatedAt": {"type": "string"}}}},
      {"name": "set-config", "targetRole": "config", "description": "Save Hermann's configuration (a new version; the newest wins).",
       "defaults": {"configId": "hermann"},
       "inputSchema": {"type": "object", "required": ["updatedAt"], "properties": {"artifactId": {"type": "string"}, "groupId": {"type": "string"}, "packageName": {"type": "string"}, "description": {"type": "string"}, "javaVersion": {"type": "string"}, "bootVersion": {"type": "string"}, "dependencies": {"type": "string"}, "claudeModel": {"type": "string"}, "claudeMaxTurns": {"type": "string"}, "implementTimeoutMin": {"type": "string"}, "giteaImage": {"type": "string"}, "giteaPort": {"type": "string"}, "giteaSshPort": {"type": "string"}, "giteaUser": {"type": "string"}, "giteaContainer": {"type": "string"}, "giteaVolume": {"type": "string"}, "hermannHome": {"type": "string"}, "blockingSeverity": {"type": "string"}, "tokenLanes": {"type": "array", "items": {"type": "string"}}, "status": {"type": "string"}, "updatedAt": {"type": "string"}}}},
      {"name": "check-infra", "targetRole": "setup-cmd", "description": "Measure the executor host: docker, git host, toolchain.",
       "command": {"role": "setup-cmd", "toolId": "hermann-infra", "argv": ["health"], "env": {"MODEL_ID": "${modelId}"}, "timeoutMs": 120000},
       "inputSchema": {"type": "object", "properties": {}}},
      {"name": "provision-git-host", "targetRole": "setup-cmd", "description": "Run the git host on the Docker host, create the admin, store the lanes' token in the vault.",
       "command": {"role": "setup-cmd", "toolId": "hermann-git", "argv": ["provision"], "env": {"MODEL_ID": "${modelId}"}, "timeoutMs": 900000},
       "inputSchema": {"type": "object", "properties": {}}},
      {"name": "bootstrap-service", "targetRole": "setup-cmd", "description": "Create the service from Spring Initializr with the twelve-factor scaffold, push it, protect main, audit it.",
       "command": {"role": "setup-cmd", "toolId": "hermann-bootstrap", "argv": ["bootstrap"], "env": {"MODEL_ID": "${modelId}"}, "timeoutMs": 2400000},
       "inputSchema": {"type": "object", "properties": {}}},
      {"name": "run-audit", "targetRole": "audit-request", "description": "Measure the twelve factors on main now.",
       "defaults": {"reason": "manual"},
       "inputSchema": {"type": "object", "required": ["at"], "properties": {"at": {"type": "string"}, "repoId": {"type": "string"}}}}
    ],
    "permissions": {
      "readStores": ["config", "goal", "adr", "cards", "infra", "repo", "iterate", "prompts", "responses", "specs", "decisions", "runs", "verification", "reviews", "scorecard", "reports", "journal", "errors", "llm-errors", "setup-cmd", "audit-request"],
      "watchStores": ["prompts", "specs", "runs", "verification", "reviews", "journal", "scorecard", "infra", "repo", "errors"],
      "actions": ["start-iteration", "respond", "approve-spec", "reject-spec", "merge", "request-changes", "set-goal", "add-adr", "decide-adr", "set-config", "check-infra", "provision-git-host", "bootstrap-service", "run-audit"]
    }
  }
}
