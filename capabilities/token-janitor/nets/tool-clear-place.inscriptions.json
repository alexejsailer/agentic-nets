[
  {
    "action": {
      "template": {
        "_correlationId": "${input.data._correlationId}",
        "allowedModels": "${policy.data.allowedModels}",
        "checkedAt": "${now()}",
        "place": "${input.data.place}",
        "protectedPlaces": "${policy.data.protectedPlaces}",
        "refusedReason": "Policy gate refused: the target model must be in allowedModels and the place must not match protectedPlaces. Nothing was deleted.",
        "requestId": "${input.data.requestId}",
        "targetModel": "${input.data.targetModel}",
        "tool": "clear-place",
        "verdict": "${default(match(input.data.probe, policy.data.gateRegex), \"DENY\")}"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "go",
        "when": "verdict != 'DENY'"
      },
      {
        "from": "@response",
        "to": "pending",
        "when": "verdict != 'DENY'"
      },
      {
        "from": "@response",
        "to": "refused",
        "when": "verdict == 'DENY'"
      },
      {
        "from": "@response",
        "to": "answer",
        "when": "verdict == 'DENY'"
      }
    ],
    "id": "t-jt-clear-gate",
    "kind": "map",
    "label": "Policy gate: one regex, both checks, literal verdict",
    "metadata": {
      "netId": "tool-clear-place",
      "sessionId": "agent-token-janitor"
    },
    "mode": "SINGLE",
    "postsets": {
      "answer": {
        "host": "default@agentic-net-node:8080",
        "placeId": "p-jt-clear-out"
      },
      "go": {
        "host": "default@agentic-net-node:8080",
        "placeId": "p-jt-clear-go"
      },
      "pending": {
        "host": "default@agentic-net-node:8080",
        "placeId": "p-jt-clear-pending"
      },
      "refused": {
        "host": "default@agentic-net-node:8080",
        "placeId": "p-janitor-refused"
      }
    },
    "presets": {
      "input": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "default@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-jt-clear-checked",
        "take": "FIRST"
      },
      "policy": {
        "arcql": "FROM $ LIMIT 1",
        "consume": false,
        "host": "default@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-janitor-policy",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "template": {
        "_correlationId": "${default(input.data._correlationId, input.data.requestId)}",
        "place": "${input.data.place}",
        "probe": "${input.data.targetModel} ${input.data.place}",
        "requestId": "${input.data.requestId}",
        "targetModel": "${input.data.targetModel}"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "checked"
      }
    ],
    "id": "t-jt-clear-probe",
    "kind": "map",
    "label": "Build the policy probe string",
    "metadata": {
      "netId": "tool-clear-place",
      "sessionId": "agent-token-janitor"
    },
    "mode": "SINGLE",
    "postsets": {
      "checked": {
        "host": "default@agentic-net-node:8080",
        "placeId": "p-jt-clear-checked"
      }
    },
    "presets": {
      "input": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "default@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-jt-clear-in",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "method": "POST",
      "timeoutMs": 120000,
      "type": "http",
      "url": "http://agentic-net-master:8082/api/runtime/places/${urlencode(go.data.place)}/tokens/deleteAll?modelId=${urlencode(go.data.targetModel)}"
    },
    "emit": [
      {
        "from": "@response.json",
        "to": "raw",
        "when": "success"
      },
      {
        "from": "@response",
        "to": "raw",
        "when": "error"
      }
    ],
    "id": "t-jt-clear-run",
    "kind": "http",
    "label": "POST /api/runtime/places/{place}/tokens/deleteAll",
    "metadata": {
      "netId": "tool-clear-place",
      "sessionId": "agent-token-janitor"
    },
    "mode": "SINGLE",
    "postsets": {
      "raw": {
        "host": "default@agentic-net-node:8080",
        "placeId": "p-jt-clear-raw"
      }
    },
    "presets": {
      "go": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "default@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-jt-clear-go",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "template": {
        "_correlationId": "${default(pending.data._correlationId, pending.data.requestId)}",
        "deletedCount": "${raw.data.deletedCount}",
        "error": "${default(raw.data.error, \"\")}",
        "finishedAt": "${now()}",
        "place": "${pending.data.place}",
        "requestId": "${pending.data.requestId}",
        "targetModel": "${pending.data.targetModel}",
        "tool": "clear-place"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "out"
      }
    ],
    "id": "t-jt-clear-shape",
    "kind": "map",
    "label": "Shape the API result and re-attach the correlation id",
    "metadata": {
      "netId": "tool-clear-place",
      "sessionId": "agent-token-janitor"
    },
    "mode": "SINGLE",
    "postsets": {
      "out": {
        "host": "default@agentic-net-node:8080",
        "placeId": "p-jt-clear-out"
      }
    },
    "presets": {
      "pending": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "default@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-jt-clear-pending",
        "take": "FIRST"
      },
      "raw": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "default@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-jt-clear-raw",
        "take": "FIRST"
      }
    }
  }
]
