  {
    "action": {
      "template": {
        "args": {
          "argv": [
            "apply",
            "${cur.data.curationId}"
          ],
          "env": {
            "CURATION_ID": "${cur.data.curationId}",
            "MODEL_ID": "steward",
            "RUN_ID": "${cur.data.runId}"
          },
          "timeoutMs": 300000,
          "toolId": "steward-brain"
        },
        "command": "invoke",
        "curationId": "${cur.data.curationId}",
        "executor": "script",
        "expect": "text",
        "filedAt": "${now()}",
        "id": "brain-apply-${now()}",
        "kind": "command",
        "stage": "apply"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "cmd"
      }
    ],
