        "from": "@result",
        "to": "log"
      }
    ],
    "id": "t-steward-curate-cmd",
    "kind": "command",
    "label": "Curate (headless agent, may read the pack repository)",
    "metadata": {
      "netId": "steward-brain",
      "sessionId": "agent-steward"
    },
    "mode": "SINGLE",
    "postsets": {
