[
  {
    "action": {
      "template": {
        "args": {
          "argv": [
            "observe",
            "scheduled"
          ],
          "env": {
            "MODEL_ID": "steward"
          },
          "timeoutMs": 600000,
          "toolId": "steward-observe"
        },
        "command": "invoke",
        "executor": "script",
        "expect": "text",
        "filedAt": "${now()}",
        "id": "observe-${now()}",
        "kind": "command",
        "reason": "scheduled",
        "stage": "observe"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "cmd"
      }
    ],
    "id": "t-steward-observe-cron",
    "kind": "map",
    "label": "Observe the model (scheduled)",
    "metadata": {
      "netId": "steward-observe",
      "sessionId": "agent-steward"
    },
    "mode": "SINGLE",
    "postsets": {
      "cmd": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-observe-cmd"
      }
    },
    "presets": {
      "charter": {
        "arcql": "FROM $ WHERE $.charterId == \"steward\" LIMIT 1",
        "consume": false,
        "host": "steward@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-steward-charter",
        "take": "FIRST"
      }
    },
    "schedule": {
      "cron": "0 30 5 * * *",
      "timezone": "Europe/Berlin",
      "type": "cron"
    }
  },
  {
    "action": {
      "await": "ALL",
      "dispatch": [
        {
          "channel": "default",
          "executor": "bash"
        }
      ],
      "executorId": "agentic-net-executor-default",
      "groupBy": "executor",
      "inputPlace": "input",
      "timeoutMs": 600000,
      "type": "command"
    },
    "description": "steward-observe measures through master and the runtime's MCP (net_stats, list_transitions, scheduler_status, usage_report, net_overview) and writes health, lanes, map and budget; it starts an iteration when no prompt, spec or run is waiting.",
    "emit": [
      {
        "from": "@result",
        "to": "log"
      }
    ],
    "id": "t-steward-observe-cmd",
    "kind": "command",
    "label": "Observe: lanes, places, errors, cost, map",
    "metadata": {
      "netId": "steward-observe",
      "sessionId": "agent-steward"
    },
    "mode": "SINGLE",
    "postsets": {
      "budget": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-budget"
      },
      "candidates": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-candidates",
        "retain": 60
      },
      "errors": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-errors"
      },
      "health": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-health"
      },
      "iterate": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-iterate"
      },
      "journal": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-journal"
      },
      "lanes": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-lanes"
      },
      "log": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-observe-log",
        "retain": 200
      },
      "map": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-map"
      }
    },
    "presets": {
      "input": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "steward@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-steward-observe-cmd",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "template": {
        "at": "${now()}",
        "contractMisses": "${health.data.contractMisses}",
        "costUsd24h": "${health.data.costUsd24h}",
        "digestId": "digest-${now()}",
        "errorState": "${health.data.errorState}",
        "executor": "${health.data.executor}",
        "fireErrors": "${health.data.fireErrors}",
        "fires": "${health.data.fires}",
        "kind": "digest",
        "lanes": "${health.data.lanes}",
        "llmErrors": "${health.data.llmErrors}",
        "observationId": "${health.data.observationId}",
        "observedAt": "${health.data.at}",
        "overdue": "${health.data.overdue}",
        "paused": "${health.data.paused}",
        "period": "daily",
        "recentErrors": "${health.data.recentErrors}",
        "running": "${health.data.running}",
        "stopped": "${health.data.stopped}",
        "stranded": "${health.data.stranded}",
        "summary": "${health.data.summary}",
        "text": "Daily digest of ${health.data.at}: ${health.data.summary}; cost 24h ${health.data.costUsd24h} USD; executor ${health.data.executor}",
        "trend": "${health.data.trend}"
      },
      "type": "map"
    },
    "description": "Every morning at 06:00 Europe/Berlin it reads the newest health token without consuming it and writes one compact digest token, so the person reads a day at a glance instead of every observation. Nothing else moves: the observe lanes and their places are untouched.",
    "emit": [
      {
        "from": "@response",
        "to": "digest"
      }
    ],
    "id": "t-steward-observe-digest",
    "kind": "map",
    "label": "Digest the newest health (daily)",
    "metadata": {
      "netId": "steward-observe",
      "sessionId": "agent-steward"
    },
    "mode": "SINGLE",
    "postsets": {
      "digest": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-digest",
        "retain": 30
      }
    },
    "presets": {
      "health": {
        "arcql": "FROM $ ORDER BY $.at DESC LIMIT 1",
        "consume": false,
        "host": "steward@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-steward-health",
        "take": "FIRST"
      }
    },
    "schedule": {
      "cron": "0 0 6 * * *",
      "timezone": "Europe/Berlin",
      "type": "cron"
    }
  },
  {
    "action": {
      "await": "ALL",
      "dispatch": [
        {
          "channel": "default",
          "executor": "bash"
        }
      ],
      "executorId": "agentic-net-executor-default",
      "groupBy": "executor",
      "inputPlace": "input",
      "timeoutMs": 120000,
      "type": "command"
    },
    "description": "steward-lane-report reads the rows of the newest p-steward-lanes observation and writes one lane-report token holding a markdown table, so the person reads the lanes instead of querying them. It measures nothing itself and touches no other place.",
    "emit": [],
    "id": "t-steward-lane-report-cmd",
    "kind": "command",
    "label": "Render the newest lane measurement as a table",
    "metadata": {
      "netId": "steward-observe",
      "sessionId": "agent-steward"
    },
    "mode": "SINGLE",
    "postsets": {
      "report": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-lane-report",
        "retain": 10
      }
    },
    "presets": {
      "input": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "steward@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-steward-lane-report-cmd",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "template": {
        "args": {
          "argv": [
            "report"
          ],
          "env": {
            "MODEL_ID": "steward"
          },
          "timeoutMs": 120000,
          "toolId": "steward-lane-report"
        },
        "command": "invoke",
        "executor": "script",
        "expect": "text",
        "filedAt": "${now()}",
        "id": "lane-report-${now()}",
        "kind": "command",
        "observationId": "${health.data.observationId}",
        "stage": "lane-report"
      },
      "type": "map"
    },
    "description": "Every morning at 06:10 Europe/Berlin, ten minutes after the digest, it reads the newest health token without consuming it and files one request for the lane report. The health read is the lane's preset and its guard: with no observation yet, nothing fires and no empty report is written.",
    "emit": [
      {
        "from": "@response",
        "to": "cmd"
      }
    ],
    "id": "t-steward-lane-report-daily",
    "kind": "map",
    "label": "Report the lanes (daily)",
    "metadata": {
      "netId": "steward-observe",
      "sessionId": "agent-steward"
    },
    "mode": "SINGLE",
    "postsets": {
      "cmd": {
        "host": "steward@agentic-net-node:8080",
        "placeId": "p-steward-lane-report-cmd"
      }
    },
    "presets": {
      "health": {
        "arcql": "FROM $ ORDER BY $.at DESC LIMIT 1",
        "consume": false,
        "host": "steward@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-steward-health",
        "take": "FIRST"
      }
    },
    "schedule": {
      "cron": "0 10 6 * * *",
      "timezone": "Europe/Berlin",
      "type": "cron"
    }
  }
]
