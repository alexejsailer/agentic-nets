    "id": "t-team-approve-prep",
    "kind": "map",
    "label": "Approved context pack to the coder",
    "metadata": {
      "netId": "net-team-dev",
      "sessionId": "team"
    },
    "mode": "SINGLE",
    "postsets": {
      "cmd": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-dev-cmd"
      }
    },
    "presets": {
      "dec": {
        "arcql": "FROM $ WHERE $.kind == \"pack-approval\" AND $.verdict == \"approved\" LIMIT 1",
        "consume": true,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-team-decisions",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "await": "ALL",
      "dispatch": [
        {
          "channel": "default",
          "executor": "bash"
        }
      ],
      "executorId": "agentic-net-executor-default",
      "groupBy": "executor",
      "inputPlace": "input",
      "timeoutMs": 3600000,
      "type": "command"
    },
    "description": "team-dev: implement <specId> (the coding agent on a branch, from the context pack only), review-brief <runId>, merge-ask <runId>, merge <runId>.",
    "emit": [
      {
        "from": "@result",
        "to": "log"
      }
    ],
    "id": "t-team-dev-cmd",
    "kind": "command",
    "label": "Developer process",
    "metadata": {
      "netId": "net-team-dev",
      "sessionId": "team"
    },
    "mode": "SINGLE",
    "postsets": {
      "brain_cmd": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-brain-cmd"
      },
      "context": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-context"
      },
      "errors": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-errors"
      },
      "journal": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-journal"
      },
      "log": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-dev-log",
        "retain": 200
      },
      "office_inbox": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-product-inbox"
      },
      "office_status": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-product-status"
      },
      "prompts": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-prompts"
      },
      "qa_cmd": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-qa-cmd"
      },
      "runs": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-runs"
      },
      "specs": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-specs"
      },
      "status": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-status"
      }
    },
    "presets": {
      "coders": {
        "arcql": "FROM $ LIMIT 1",
        "consume": false,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": true,
        "placeId": "p-team-coders",
        "take": "FIRST"
      },
      "input": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-team-dev-cmd",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "allowedTools": [],
      "answerSchema": {
        "required": [
          "reviewId",
          "runId",
          "specId",
          "verdict",
          "summary"
        ],
        "retries": 1,
        "types": {
          "acceptanceMissing": "array",
          "points": "array",
          "specDeviations": "array"
        }
      },
      "autoEmit": true,
      "maxIterations": 1,
      "modelId": "agenticnets-product",
      "nl": "You are the DEVELOPER's reviewer of the ${ctx.data.service} service (a second pair of eyes). Read the brief with the diff, the spec and the acceptance, then reply with ONE JSON object and nothing else.\n\n${ctx.data.brief}\n\nReply EXACTLY: {\"reviewId\": <from the brief>, \"runId\": <from the brief>, \"specId\": <from the brief>, \"verdict\": \"approve|changes\", \"summary\": <three sentences>, \"points\": [{\"severity\": \"blocking|major|minor\", \"file\": <file>, \"comment\": <what and why>}], \"acceptanceMissing\": [<criteria the diff does not satisfy>], \"specDeviations\": [<where the diff departs from the spec>]}. Rules: verdict changes when any point is blocking, a criterion is missing, or the diff touches files outside the spec's files and scope without reason; otherwise approve.",
      "oneShot": true,
      "role": "r",
      "sessionId": "team",
      "tier": "medium",
      "type": "agent"
    },
    "emit": [
      {
        "from": "@response",
        "to": "out",
        "when": "verdict == 'approve' OR verdict == 'changes'"
      },
      {
        "from": "@response",
        "to": "new",
        "when": "verdict == 'approve' OR verdict == 'changes'"
      },
      {
        "from": "@response",
        "to": "errors",
        "when": "verdict != 'approve' AND verdict != 'changes'"
      },
      {
        "from": "@response",
        "to": "errors",
        "when": "error"
      }
    ],
    "id": "t-team-review",
    "kind": "agent",
    "label": "Review the diff against spec and acceptance",
    "metadata": {
      "netId": "net-team-dev",
      "sessionId": "team"
    },
    "mode": "SINGLE",
    "postsets": {
      "errors": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-llm-errors",
        "retain": 100
      },
      "new": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-review-new"
      },
      "out": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-reviews"
      }
    },
    "presets": {
      "ctx": {
        "arcql": "FROM $ WHERE $.purpose == \"review\" LIMIT 1",
        "consume": true,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-team-context",
        "reservationTtlMs": 900000,
        "take": "FIRST"
      }
    },
    "role": "r"
  },
  {
