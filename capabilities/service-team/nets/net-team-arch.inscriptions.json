[
  {
    "action": {
      "template": {
        "args": {
          "argv": [
            "design-brief",
            "${req.data.requirementId}",
            "p-team-charter"
          ],
          "env": {
            "MODEL_ID": "agenticnets-product"
          },
          "timeoutMs": 300000,
          "toolId": "team-arch"
        },
        "command": "invoke",
        "executor": "script",
        "expect": "text",
        "filedAt": "${now()}",
        "id": "design-brief-${now()}",
        "kind": "command",
        "requirementId": "${req.data.requirementId}",
        "stage": "design-brief"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "cmd"
      }
    ],
    "id": "t-team-design-prep",
    "kind": "map",
    "label": "Requirement to design brief",
    "metadata": {
      "netId": "net-team-arch",
      "sessionId": "team"
    },
    "mode": "SINGLE",
    "postsets": {
      "cmd": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-arch-cmd"
      }
    },
    "presets": {
      "req": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-team-requirement-drafts",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "await": "ALL",
      "dispatch": [
        {
          "channel": "default",
          "executor": "bash"
        }
      ],
      "executorId": "agentic-net-executor-default",
      "groupBy": "executor",
      "inputPlace": "input",
      "timeoutMs": 900000,
      "type": "command"
    },
    "description": "team-arch: design-brief, catalog (mirror the code structure into places and links), spec-gate (ask the person to approve a spec), pack (the context pack for the coder, then the policy gate).",
    "emit": [
      {
        "from": "@result",
        "to": "log"
      }
    ],
    "id": "t-team-arch-cmd",
    "kind": "command",
    "label": "Architect process",
    "metadata": {
      "netId": "net-team-arch",
      "sessionId": "team"
    },
    "mode": "SINGLE",
    "postsets": {
      "adr": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-adr"
      },
      "arch": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-arch"
      },
      "briefs": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-briefs"
      },
      "catalog": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-spec-catalog",
        "retain": 20
      },
      "context": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-context"
      },
      "decisions": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-decisions"
      },
      "errors": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-errors"
      },
      "journal": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-journal"
      },
      "log": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-arch-log",
        "retain": 200
      },
      "office_inbox": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-product-inbox"
      },
      "office_specs": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-product-specs"
      },
      "prompts": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-prompts"
      },
      "refused": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-refused"
      },
      "specs": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-specs"
      }
    },
    "presets": {
      "input": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-team-arch-cmd",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "allowedTools": [],
      "answerSchema": {
        "required": [
          "specId",
          "requirementId",
          "iterationId",
          "title",
          "module",
          "summary",
          "design",
          "files",
          "verify",
          "status"
        ],
        "retries": 1,
        "types": {
          "constraints": "array",
          "data": "array",
          "design": "array",
          "files": "array",
          "interfaces": "array",
          "risks": "array"
        }
      },
      "autoEmit": true,
      "maxIterations": 1,
      "modelId": "agenticnets-product",
      "nl": "You are the ARCHITECT of the ${ctx.data.service} service. A requirement was written; you write THE SPEC that must exist before anyone implements it, in the team's spec catalog which mirrors the code structure. Read the brief, then reply with ONE JSON object and nothing else.\n\n${ctx.data.brief}\n\nReply EXACTLY: {\"specId\": <from the brief>, \"requirementId\": <from the brief>, \"iterationId\": <from the brief>, \"title\": <one line>, \"module\": <the catalog module path this spec belongs to, from THE SPEC CATALOG; the closest existing module, or a new path under it>, \"summary\": <three sentences: what changes and why>, \"design\": [<numbered design steps, each one concrete change to one file or component>], \"interfaces\": [<endpoints, classes, messages, config keys added or changed>], \"data\": [<schema, storage or token shape changes, or none>], \"files\": [<files expected to change, relative to the service directory>], \"constraints\": [<what must not change>], \"verify\": <how QA proves it after implementation, one paragraph>, \"risks\": [<risks>], \"adr\": null or {\"title\": <short>, \"context\": <why a decision is needed>, \"decision\": <what is decided>, \"consequences\": <what it constrains>}, \"status\": \"draft\"}. Rules: respect the ACCEPTED DECISIONS and the principles; the spec is complete enough that a coder needs nothing else but the files; propose an adr only for a choice that constrains future changes.",
      "oneShot": true,
      "role": "r",
      "sessionId": "team",
      "tier": "medium",
      "type": "agent"
    },
    "emit": [
      {
        "from": "@response",
        "to": "out",
        "when": "status == 'draft'"
      },
      {
        "from": "@response",
        "to": "drafts",
        "when": "status == 'draft'"
      },
      {
        "from": "@response",
        "to": "errors",
        "when": "status != 'draft'"
      },
      {
        "from": "@response",
        "to": "errors",
        "when": "error"
      }
    ],
    "id": "t-team-design",
    "kind": "agent",
    "label": "Write the spec",
    "metadata": {
      "netId": "net-team-arch",
      "sessionId": "team"
    },
    "mode": "SINGLE",
    "postsets": {
      "drafts": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-spec-drafts"
      },
      "errors": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-llm-errors",
        "retain": 100
      },
      "out": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-specs"
      }
    },
    "presets": {
      "ctx": {
        "arcql": "FROM $ WHERE $.purpose == \"design\" LIMIT 1",
        "consume": true,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-team-context",
        "reservationTtlMs": 900000,
        "take": "FIRST"
      }
    },
    "role": "r"
  },
  {
    "action": {
      "template": {
        "args": {
          "argv": [
            "spec-gate",
            "${d.data.specId}",
