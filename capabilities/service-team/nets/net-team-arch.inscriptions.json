      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "cmd"
      }
    ],
    "id": "t-team-spec-gate-prep",
    "kind": "map",
    "label": "Spec draft to the person's approval",
    "metadata": {
      "netId": "net-team-arch",
      "sessionId": "team"
    },
    "mode": "SINGLE",
    "postsets": {
      "cmd": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-arch-cmd"
      }
    },
    "presets": {
      "d": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-team-spec-drafts",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "template": {
        "args": {
          "argv": [
            "pack",
            "${acc.data.specId}",
            "p-team-charter"
          ],
          "env": {
            "MODEL_ID": "agenticnets-product"
          },
          "timeoutMs": 300000,
          "toolId": "team-arch"
        },
        "command": "invoke",
        "executor": "script",
        "expect": "text",
        "filedAt": "${now()}",
        "id": "pack-${now()}",
        "kind": "command",
        "specId": "${acc.data.specId}",
        "stage": "pack"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "cmd"
      }
    ],
    "id": "t-team-pack-prep",
    "kind": "map",
    "label": "Acceptance to context pack",
    "metadata": {
      "netId": "net-team-arch",
      "sessionId": "team"
    },
    "mode": "SINGLE",
    "postsets": {
      "cmd": {
        "host": "agenticnets-product@agentic-net-node:8080",
        "placeId": "p-team-arch-cmd"
      }
    },
    "presets": {
      "acc": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "agenticnets-product@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-team-acceptance-new",
        "take": "FIRST"
      }
    }
  }
]
