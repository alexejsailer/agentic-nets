{
  "$schema": "../../../agentic-net-apps/schemas/application-package.schema.json",
  "name": "web-investigator",
  "version": "1.7.0",
  "displayName": "Web Investigator",
  "description": "Browse what the investigation crawled — findings by recency, analyses, gaps, crawl health — and record decisions: accept recommendations as article tasks, dismiss, mark covered, steer the crawl.",
  "author": "AgenticNetOS",
  "visibility": "public",
  "tags": [
    "application",
    "research",
    "web-investigator"
  ],
  "runtimePackage": "runtime/session.package.json",
  "output": "web-investigator-1.7.0.application.json",
  "ui": {
    "element": "agenticos-web-investigator-v1",
    "entryFile": "ui/main.mjs",
    "sdkVersion": "^0.1.0",
    "isolation": "trusted-element"
  },
  "application": {
    "scope": "model",
    "instancePolicy": "singleton",
    "stores": [
      {
        "role": "brief",
        "placeId": "p-scout-brief",
        "required": true,
        "description": "The investigation definition: topic, categories, scoring terms, host rules. Edit via the Token Workbench, not here."
      },
      {
        "role": "brand-new",
        "placeId": "p-find-brand-new",
        "required": true,
        "description": "Findings published within the brief's brand-new window. The most urgent competitor signal."
      },
      {
        "role": "recent",
        "placeId": "p-find-recent",
        "required": true,
        "description": "Findings published within the brief's recent window."
      },
      {
        "role": "archive",
        "placeId": "p-find-archive",
        "required": false,
        "description": "Older findings. The view shows the newest slice; query the place for the full corpus."
      },
      {
        "role": "digest",
        "placeId": "p-scout-digest",
        "required": true,
        "description": "Landscape analyses: owned angles, freshness, fresh signal, gaps, own position, recommendations."
      },
      {
        "role": "taxonomy",
        "placeId": "p-scout-taxonomy",
        "required": true,
        "description": "Deterministic per-category rollup with recency split, own-coverage and the facts token the digest reads."
      },
      {
        "role": "insights",
        "placeId": "p-scout-insights",
        "required": false,
        "description": "Crawl-health rollups with concrete tuning suggestions."
      },
      {
        "role": "frontier",
        "placeId": "p-scout-frontier",
        "required": true,
        "description": "URLs queued for the crawl. queue-url writes here; the fetch lane consumes."
      },
      {
        "role": "queries",
        "placeId": "p-scout-queries",
        "required": false,
        "description": "Search queries for the optional widening lane. queue-query writes here."
      },
      {
        "role": "owned",
        "placeId": "p-scout-owned",
        "required": false,
        "description": "The owner's own published articles (slugs only, indexed from the sitemap, never crawled)."
      },
      {
        "role": "tasks",
        "placeId": "p-scout-article-tasks",
        "required": true,
        "description": "Accepted recommendations with their evidence. Drained by the operator or a future writing persona.",
        "schema": {
          "type": "object",
          "required": [
            "taskId",
            "title"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "enum": [
                "accepted",
                "done"
              ]
            },
            "rationale": {
              "type": "string"
            },
            "gapCategory": {
              "type": "string"
            },
            "competitorUrl": {
              "type": "string"
            },
            "blobUrn": {
              "type": "string"
            }
          }
        }
      },
      {
        "role": "decisions",
        "placeId": "p-scout-decisions",
        "required": true,
        "description": "Append-only audit of operator decisions: dismissals, covered-marks, task completions."
      },
      {
        "role": "requests",
        "placeId": "p-scout-app-requests",
        "required": true,
        "description": "Run-now requests. The net's own lane consumes these and builds the actual command tokens — the app never executes anything itself."
      },
      {
        "role": "drafts",
        "placeId": "p-scout-drafts",
        "required": false,
        "description": "Publish-ready drafts written by the staff-writer lane from accepted tasks. The task itself is never consumed — close it with complete-task once published.",
        "schema": {
          "type": "object",
          "required": [
            "taskId",
            "title",
            "draftMarkdown"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "enum": [
                "draft"
              ]
            },
            "wordCount": {
              "type": "string"
            },
            "draftMarkdown": {
              "type": "string"
            }
          }
        }
      },
      {
        "role": "sources",
        "placeId": "p-scout-sources",
        "required": false,
        "description": "One profile per source host: what KIND of place it is (blog/forum/social/video/news/commercial/docs), volume, freshness, first/last seen. Rebuilt by every rollup."
      },
      {
        "role": "growth",
        "placeId": "p-scout-growth",
        "required": false,
        "description": "Append-only expansion snapshots: findings, hosts, by-type and recency splits, and what is NEW since the previous snapshot. The series behind the growth chart."
      },
      {
        "role": "source-requests",
        "placeId": "p-scout-source-requests",
        "required": false,
        "description": "Onboarding asks: a website whose sitemap should be discovered and harvested. Consumed by the harvest run."
      },
      {
        "required": false,
        "role": "policies",
        "placeId": "p-scout-source-policy",
        "description": "Per-host crawl policy set from the dashboard: allow (default), index-only (fetch for links, never classify), ignore (never fetch). Append-only; the newest token per host wins. Fetch, harvest and recrawl honour it."
      },
      {
        "required": false,
        "role": "usage",
        "placeId": "p-scout-usage",
        "description": "One token per day of measured usage: total tokens and fires plus the per-lane breakdown with tier and group, filed by the usage rollup lane (nightly, or Refresh cost)."
      },
      {
        "role": "errors",
        "placeId": "p-scout-errors",
        "required": false,
        "description": "Read-only: agent answer mismatches, malformed findings and unknown run requests, newest last. What the retry lane consumes and what the health card counts."
      },
      {
        "role": "rejected",
        "placeId": "p-scout-rejected",
        "required": false,
        "description": "Read-only: every page the deterministic gate or the route lane turned away, with its gateVerdict, pageType and score, so 'why was this page rejected' is answered on the dashboard."
      },
      {
        "role": "health-log",
        "placeId": "p-scout-health-log",
        "required": false,
        "description": "Read-only: the stdout summaries of the command lanes (health, rollup, harvest, recrawl, usage)."
      }
    ],
    "actions": [
      {
        "name": "accept-recommendation",
        "targetRole": "tasks",
        "description": "Turn a digest recommendation (or any finding) into an article task, carrying its evidence.",
        "defaults": {
          "kind": "article-task",
          "status": "accepted"
        },
        "guard": {
          "role": "tasks",
          "matchKey": "taskId",
          "exists": false
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "taskId",
            "title"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "description": "Stable id, e.g. task-overheating"
            },
            "title": {
              "type": "string",
              "description": "Working title of the article to write"
            },
            "rationale": {
              "type": "string",
              "description": "Why this, quoting the gap or fresh signal"
            },
            "gapCategory": {
              "type": "string"
            },
            "competitorUrl": {
              "type": "string",
              "description": "The competitor piece this answers"
            },
            "blobUrn": {
              "type": "string",
              "description": "Stored full text of that piece, if any"
            },
            "source": {
              "type": "string",
              "description": "Which digest/finding this came from"
            }
          }
        }
      },
      {
        "name": "dismiss",
        "targetRole": "decisions",
        "description": "Reject a recommendation or finding, with the reason on record.",
        "defaults": {
          "kind": "decision",
          "verdict": "dismissed"
        },
        "guard": {
          "role": "decisions",
          "matchKey": "decisionId",
          "exists": false
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "decisionId",
            "subject"
          ],
          "properties": {
            "decisionId": {
              "type": "string"
            },
            "subject": {
              "type": "string",
              "description": "URL or recommendation text being dismissed"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "mark-covered",
        "targetRole": "decisions",
        "description": "Record that a competitor finding is already covered by the owner's site.",
        "defaults": {
          "kind": "decision",
          "verdict": "covered-by-own"
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "decisionId",
            "url"
          ],
          "properties": {
            "decisionId": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "description": "The competitor URL that is covered"
            },
            "ownSlug": {
              "type": "string",
              "description": "The owner article that covers it"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "complete-task",
        "targetRole": "decisions",
        "description": "Close an accepted article task; the task token flips to done atomically.",
        "defaults": {
          "kind": "decision",
          "verdict": "task-completed"
        },
        "guard": {
          "role": "tasks",
          "matchKey": "taskId",
          "where": {
            "status": [
              "accepted"
            ]
          }
        },
        "effects": [
          {
            "updateRole": "tasks",
            "matchKey": "taskId",
            "set": {
              "status": "done"
            },
            "setFromInput": {
              "doneNote": "note"
            }
          }
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "taskId"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "note": {
              "type": "string",
              "description": "Outcome, e.g. the published URL"
            }
          }
        }
      },
      {
        "name": "queue-url",
        "targetRole": "frontier",
        "description": "Queue a URL for the crawl. The running fetch lane picks it up on its next binding.",
        "defaults": {
          "depth": 0,
          "discoveredFrom": "web-investigator-app"
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "queue-query",
        "targetRole": "queries",
        "description": "Queue a search query for the optional widening lane (needs its API key configured).",
        "defaults": {
          "kind": "search-query"
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "request-run",
        "targetRole": "requests",
        "description": "Ask the net to run a rollup now. Its own lane builds and executes the command; the app only records the request.",
        "defaults": {
          "kind": "app-request",
          "status": "requested"
        },
        "guard": {
          "role": "requests",
          "matchKey": "requestId",
          "exists": false
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "requestId",
            "run"
          ],
          "properties": {
            "requestId": {
              "type": "string",
              "description": "Unique per request, e.g. run-2026-09-01-a"
            },
            "run": {
              "enum": [
                "taxonomy",
                "owned",
                "health",
                "write",
                "recrawl",
                "sitemap",
                "write-fable",
                "usage"
              ],
              "description": "taxonomy = rollup + analysis; owned = re-index own sitemap; health = crawl diagnostics; write = draft next accepted task; recrawl = re-queue known sources' entry pages; sitemap = discover + harvest source sitemaps (incl. pending add-source requests); write-fable = draft ONE named task with a named model"
            },
            "taskId": {
              "type": "string",
              "description": "For write-fable: the article task to draft. Ignored by the other runs."
            },
            "writerModel": {
              "type": "string",
              "description": "For write-fable: model alias handed to the writer (e.g. fable)."
            }
          }
        }
      },
      {
        "name": "add-source",
        "targetRole": "source-requests",
        "description": "Onboard a website: the next sitemap harvest discovers its sitemap and queues its articles into the crawl.",
        "defaults": {
          "kind": "source-request"
        },
        "guard": {
          "role": "source-requests",
          "matchKey": "url",
          "exists": false
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The site, e.g. https://example.com/"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "set-source-policy",
        "targetRole": "policies",
        "description": "Record a per-host crawl policy. The crawl reads the newest policy per host: ignore skips the fetch entirely, index-only fetches for links but never classifies, allow restores the default.",
        "defaults": {
          "kind": "source-policy"
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "host",
            "policy"
          ],
          "properties": {
            "host": {
              "type": "string",
              "description": "Host name without scheme, e.g. example.com"
            },
            "policy": {
              "type": "string",
              "enum": [
                "allow",
                "index-only",
                "ignore"
              ]
            },
            "setAt": {
              "type": "string",
              "description": "ISO timestamp; newest wins"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "review-draft",
        "targetRole": "decisions",
        "description": "Record what happened to a draft after a human read it, so writers and evidence packs can be compared over time.",
        "defaults": {
          "kind": "decision",
          "verdict": "draft-reviewed"
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "taskId",
            "revision",
            "rating"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "rating": {
              "type": "string",
              "enum": [
                "used",
                "edited",
                "discarded"
              ],
              "description": "used as is | edited heavily | discarded"
            },
            "writerModel": {
              "type": "string"
            },
            "reviewedAt": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "create-brief",
        "targetRole": "brief",
        "description": "Write the investigation brief. Ships inactive: nothing classifies or analyses until resume-investigation flips it active.",
        "defaults": {
          "kind": "brief",
          "active": "false"
        },
        "guard": {
          "role": "brief",
          "matchKey": "briefId",
          "exists": false
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "briefId",
            "topic",
            "categories",
            "mustInclude"
          ],
          "properties": {
            "topic": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "domainHint": {
              "type": "string"
            },
            "categories": {
              "type": "string"
            },
            "mustInclude": {
              "type": "string"
            },
            "denyHosts": {
              "type": "string"
            },
            "ownSitemap": {
              "type": "string"
            },
            "maxDepth": {
              "type": "string"
            },
            "brandNewDays": {
              "type": "string"
            },
            "recentDays": {
              "type": "string"
            },
            "minScore": {
              "type": "string"
            },
            "briefId": {
              "type": "string",
              "description": "Stable id of the brief token"
            }
          }
        }
      },
      {
        "name": "update-brief",
        "targetRole": "decisions",
        "description": "Edit the brief in place; the decision token is the audit record of what changed.",
        "defaults": {
          "kind": "decision",
          "verdict": "brief-updated"
        },
        "guard": {
          "role": "brief",
          "matchKey": "briefId"
        },
        "effects": [
          {
            "updateRole": "brief",
            "matchKey": "briefId",
            "setFromInput": {
              "topic": "topic",
              "description": "description",
              "domainHint": "domainHint",
              "categories": "categories",
              "mustInclude": "mustInclude",
              "denyHosts": "denyHosts",
              "ownSitemap": "ownSitemap",
              "maxDepth": "maxDepth",
              "brandNewDays": "brandNewDays",
              "recentDays": "recentDays",
              "minScore": "minScore"
            }
          }
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "briefId",
            "topic",
            "categories",
            "mustInclude"
          ],
          "properties": {
            "topic": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "domainHint": {
              "type": "string"
            },
            "categories": {
              "type": "string"
            },
            "mustInclude": {
              "type": "string"
            },
            "denyHosts": {
              "type": "string"
            },
            "ownSitemap": {
              "type": "string"
            },
            "maxDepth": {
              "type": "string"
            },
            "brandNewDays": {
              "type": "string"
            },
            "recentDays": {
              "type": "string"
            },
            "minScore": {
              "type": "string"
            },
            "briefId": {
              "type": "string",
              "description": "Stable id of the brief token"
            }
          }
        }
      },
      {
        "name": "pause-investigation",
        "targetRole": "decisions",
        "description": "Flip the brief inactive. Every model lane binds the brief only while active != false, so classification and analysis stop at once; the fetch lanes keep draining their queue.",
        "defaults": {
          "kind": "decision",
          "verdict": "brief-paused"
        },
        "guard": {
          "role": "brief",
          "matchKey": "briefId"
        },
        "effects": [
          {
            "updateRole": "brief",
            "matchKey": "briefId",
            "set": {
              "active": "false"
            }
          }
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "briefId"
          ],
          "properties": {
            "briefId": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "resume-investigation",
        "targetRole": "decisions",
        "description": "Flip the brief active again.",
        "defaults": {
          "kind": "decision",
          "verdict": "brief-resumed"
        },
        "guard": {
          "role": "brief",
          "matchKey": "briefId"
        },
        "effects": [
          {
            "updateRole": "brief",
            "matchKey": "briefId",
            "set": {
              "active": "true"
            }
          }
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "briefId"
          ],
          "properties": {
            "briefId": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "reopen-task",
        "targetRole": "decisions",
        "description": "Undo Done: the task goes back to accepted.",
        "defaults": {
          "kind": "decision",
          "verdict": "task-reopened"
        },
        "guard": {
          "role": "tasks",
          "matchKey": "taskId",
          "where": {
            "status": [
              "done"
            ]
          }
        },
        "effects": [
          {
            "updateRole": "tasks",
            "matchKey": "taskId",
            "set": {
              "status": "accepted"
            }
          }
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "taskId"
          ],
          "properties": {
            "taskId": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    ],
    "permissions": {
      "readStores": [
        "brief",
        "brand-new",
        "recent",
        "archive",
        "digest",
        "taxonomy",
        "insights",
        "frontier",
        "queries",
        "owned",
        "tasks",
        "decisions",
        "requests",
        "drafts",
        "sources",
        "growth",
        "source-requests",
        "policies",
        "usage",
        "errors",
        "rejected",
        "health-log"
      ],
      "watchStores": [
        "requests",
        "tasks",
        "decisions",
        "drafts",
        "digest",
        "insights"
      ],
      "actions": [
        "accept-recommendation",
        "dismiss",
        "mark-covered",
        "complete-task",
        "queue-url",
        "queue-query",
        "request-run",
        "add-source",
        "set-source-policy",
        "review-draft",
        "create-brief",
        "update-brief",
        "pause-investigation",
        "resume-investigation",
        "reopen-task"
      ]
    },
    "agentProtocol": {
      "taskStoreRole": "tasks",
      "activityStoreRole": "decisions",
      "readyStatuses": [
        "accepted"
      ],
      "terminalStatuses": [
        "done"
      ],
      "poll": {
        "intervalMs": 60000
      },
      "rules": [
        "Tasks carry their evidence (rationale, competitorUrl, blobUrn) — read it before writing anything.",
        "Record every outcome through complete-task so the task flips atomically; never edit task tokens directly."
      ]
    },
    "surface": {
      "route": "web-investigator",
      "icon": "search",
      "defaultView": "stores"
    }
  }
}
