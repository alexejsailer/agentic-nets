    "kind": "map",
    "label": "Build health CommandToken",
    "mode": "SINGLE",
    "presets": {
      "input": {
        "placeId": "p-scout-brief",
        "host": "research-scout@agentic-net-node:8080",
        "arcql": "FROM $ LIMIT 1",
        "take": "FIRST",
        "consume": false,
        "optional": false
      }
    },
    "postsets": {
      "out": {
        "placeId": "p-scout-health-cmd",
        "host": "research-scout@agentic-net-node:8080"
      }
    },
    "action": {
      "type": "map",
      "template": {
        "kind": "command",
        "id": "health-${now()}",
        "executor": "script",
        "command": "invoke",
