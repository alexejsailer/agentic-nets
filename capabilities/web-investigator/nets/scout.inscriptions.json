  },
  {
    "action": {
      "template": {
        "args": {
          "argv": [],
          "env": {
            "MODEL_ID": "research-scout"
          },
          "timeoutMs": 90000,
          "toolId": "scout-taxonomy"
        },
        "command": "invoke",
        "executor": "script",
        "expect": "text",
        "id": "taxonomy-${now()}",
        "kind": "command"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "out"
      }
    ],
    "id": "t-scout-taxonomy-cmd",
    "kind": "map",
    "label": "Build taxonomy CommandToken",
    "metadata": {
      "netId": "scout",
      "sessionId": "dev-support-council"
    },
    "mode": "SINGLE",
    "postsets": {
