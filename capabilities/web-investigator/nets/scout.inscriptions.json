    "kind": "map",
    "label": "Build search CommandToken",
    "metadata": {
      "netId": "scout",
      "sessionId": "dev-support-council"
    },
    "mode": "FOREACH",
    "postsets": {
      "out": {
        "host": "research-scout@agentic-net-node:8080",
        "placeId": "p-scout-search-cmd"
      }
    },
    "presets": {
      "config": {
        "arcql": "FROM $ WHERE $.active == \"true\" LIMIT 1",
        "consume": false,
        "host": "research-scout@agentic-net-node:8080",
        "optional": false,
        "placeId": "p-scout-brief",
        "take": "FIRST"
      },
      "input": {
        "arcql": "FROM $ LIMIT 3",
        "consume": true,
        "host": "research-scout@agentic-net-node:8080",
        "placeId": "p-scout-queries",
        "take": "ALL"
      }
    }
  },
  {
    "action": {
      "template": {
        "error": "${input.data.parsedStdout.error}",
        "found": "${input.data.parsedStdout.found}",
        "frontierCandidates": "${input.data.parsedStdout.frontierCandidates}",
        "hostFiltered": "${input.data.parsedStdout.hostFiltered}",
        "kind": "search",
        "known": "${input.data.parsedStdout.known}",
        "malformed": "${input.data.parsedStdout.malformed}",
        "outcome": "${input.data.parsedStdout.outcome}",
        "provider": "${input.data.parsedStdout.provider}",
        "query": "${input.data.parsedStdout.query}",
        "queued": "${input.data.parsedStdout.queued}",
        "queuedAt": "${now()}",
        "ts": "${input.data.parsedStdout.ts}"
      },
      "type": "map"
    },
    "emit": [
      {
        "fanOut": true,
        "from": "@response.frontierCandidates",
        "to": "scout_frontier"
      },
      {
        "from": "@response",
        "to": "err",
        "when": "outcome == 'failed'"
      },
      {
        "from": "@response",
        "to": "out"
      }
    ],
    "id": "t-scout-search-lift",
    "kind": "map",
    "label": "Lift search result, fan hits into frontier",
