        "placeId": "p-scout-frontier"
      }
    },
    "presets": {
      "input": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "research-scout@agentic-net-node:8080",
        "placeId": "p-scout-search-raw",
        "take": "FIRST"
      }
    }
