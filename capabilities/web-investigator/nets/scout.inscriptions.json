      "netId": "scout",
      "sessionId": "dev-support-council"
    },
    "postsets": {
      "to": {
        "host": "research-scout@agentic-net-node:8080",
        "placeId": "p-scout-taxonomy"
      }
    },
    "presets": {
      "from": {
        "arcql": "FROM $ LIMIT 1",
        "consume": false,
        "host": "research-scout@agentic-net-node:8080",
        "optional": true,
        "placeId": "p-scout-brief",
        "take": "FIRST"
      }
    },
    "relation": "defines"
  },
  {
    "id": "t-link-insights-brief",
