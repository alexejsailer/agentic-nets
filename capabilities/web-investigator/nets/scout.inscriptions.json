  {
    "action": {
      "template": {
        "ageDays": "${input.data.ageDays}",
        "blobUrn": "${input.data.blobUrn}",
        "briefId": "${input.data.briefId}",
        "dateSource": "${input.data.dateSource}",
        "depth": "${input.data.depth}",
        "extract": "${input.data.extract}",
        "extractChars": "${input.data.extractChars}",
        "gateVerdict": "${input.data.gateVerdict}",
        "gatedAt": "${now()}",
        "host": "${input.data.host}",
        "pageType": "${input.data.pageType}",
        "publishedAt": "${input.data.publishedAt}",
        "recency": "${input.data.recency}",
        "score": "${input.data.score}",
        "title": "${input.data.title}",
        "url": "${input.data.url}"
      },
      "type": "map"
    },
    "emit": [
      {
        "from": "@response",
        "to": "scout_candidates",
        "when": "gateVerdict == 'pass'"
      },
      {
        "from": "@response",
        "to": "scout_rejected",
        "when": "gateVerdict == 'low-score'"
      },
      {
        "from": "@response",
        "to": "scout_rejected",
        "when": "gateVerdict == 'index'"
      }
    ],
    "id": "t-scout-gate",
    "kind": "map",
    "label": "Gate: articles above minScore only",
    "metadata": {
      "netId": "scout",
      "sessionId": "dev-support-council"
    },
    "mode": "SINGLE",
    "postsets": {
      "scout_candidates": {
        "host": "research-scout@agentic-net-node:8080",
        "placeId": "p-scout-candidates"
      },
      "scout_rejected": {
        "host": "research-scout@agentic-net-node:8080",
        "placeId": "p-scout-rejected"
      }
    },
    "presets": {
      "input": {
        "arcql": "FROM $ LIMIT 1",
        "consume": true,
        "host": "research-scout@agentic-net-node:8080",
        "placeId": "p-scout-fetched",
        "take": "FIRST"
      }
    }
  },
  {
    "action": {
      "await": "ALL",
      "dispatch": [
        {
          "channel": "default",
          "executor": "bash"
        }
      ],
      "executorId": "agentic-net-executor-default",
      "groupBy": "executor",
      "inputPlace": "input",
      "timeoutMs": 120000,
      "type": "command"
    },
    "emit": [
      {
        "from": "@result",
        "to": "log"
      }
