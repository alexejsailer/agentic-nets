<?xml version="1.0" encoding="UTF-8"?>
<!--
    Standard AgenticNetOS logging configuration — keep this file in sync across
    all Java services (core/ and agentic-nets/); only LOG_FILE and the
    service-specific loggers differ per service.

    CONSOLE is always on: containers log to stdout for `docker logs` and log
    aggregation (the compose files cap the json-file driver at 50m x 3).
    FILE rolls at ${LOG_PATH:-/tmp}/<service>.log; compose sets LOG_PATH=/app/logs
    (bind-mounted to ./data/logs/<service>), native runs fall back to /tmp.

    Rollover is tunable via the standard Spring properties (wired live through the
    springProperty hooks below): logging.logback.rollingpolicy.max-file-size /
    max-history / total-size-cap. Log levels come from logging.level.* as usual.
-->
<configuration>
    <springProperty scope="context" name="ROLL_MAX_FILE_SIZE" source="logging.logback.rollingpolicy.max-file-size" defaultValue="50MB"/>
    <springProperty scope="context" name="ROLL_MAX_HISTORY" source="logging.logback.rollingpolicy.max-history" defaultValue="7"/>
    <springProperty scope="context" name="ROLL_TOTAL_SIZE_CAP" source="logging.logback.rollingpolicy.total-size-cap" defaultValue="500MB"/>

    <property name="LOG_PATH" value="${LOG_PATH:-/tmp}"/>
    <property name="LOG_FILE" value="agentic-net-executor"/>
    <property name="STD_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{trace_id},%X{span_id}] - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${STD_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${ROLL_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${ROLL_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${ROLL_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${STD_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Service-specific loggers -->
    <logger name="com.sailer.agenticos" level="INFO"/>

    <!-- Silence chatty polling service logging -->
    <logger name="com.sailer.agenticos.agenticnetexecutor.service.MasterPollingService" level="WARN"/>
    <logger name="com.sailer.agenticos.agenticnetexecutor.transition" level="INFO"/>

    <!-- Silence Spring/Reactor framework noise -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web.reactive.function.client.ExchangeFunctions" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
