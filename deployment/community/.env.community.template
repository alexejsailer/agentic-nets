# Community platform settings (copy to community/.env.community; never commit the copy).
# Generate every secret fresh: openssl rand -hex 24 (32 for the credentials key).

COMMUNITY_PROJECT_NAME=agenticos-community
# Where the project keeps its data (models, vault, gateway keys + tenants.json, logs)
COMMUNITY_DATA_DIR=/opt/agenticos-community/data
# Public origin people use (Studio at /, MCP at /mcp)
COMMUNITY_PUBLIC_URL=https://community.example.com

# Images: 2.62.0 or later (tenancy, community mode, AI switch)
AGENTICNETOS_VERSION=2.62.0
# AGENTICNETOS_IMAGE_PREFIX=localhost:5000/agenticnetos   # to run images from a private registry

AGENTICOS_SERVICE_TOKEN=
AGENTICOS_CREDENTIALS_KEY=
GATEWAY_INTERNAL_SECRET=
# The operator's admin secret (blank = generated into data/gateway/jwt/admin-secret on first start)
AGENTICOS_ADMIN_SECRET=

# Accounts: off (the operator issues keys) | invite (sign-up with a code) | open (anyone)
AGENTICOS_TENANCY_SIGNUP=invite
AGENTICOS_TENANCY_INVITE_CODES=
AGENTICOS_TENANCY_MODELS_MAX=5
AGENTICOS_TENANCY_RATE_LIMIT=300

# Loopback ports (Apache forwards to them)
COMMUNITY_GATEWAY_PORT=18083
COMMUNITY_MCP_PORT=18091
COMMUNITY_GUI_PORT=14200
