COMPOSE_PROJECT_NAME=agenticos-test
AGENTICNETOS_VERSION=dev
AGENTICNETOS_BIND_ADDRESS=127.0.0.1
# isolated node data: a bare name => a project-scoped NAMED volume (declared in the
# test override), NOT the dev's ~/.agenticos bind. Lives in the Docker VM so init-perms
# can chown it (macOS bind mounts cannot be chowned) and the test node never touches
# the native node's real models.
AGENTICNETOS_NODE_DATA_DIR=test-node-data
AGENTIC_NET_NODE_PORT=18080
AGENTIC_NET_MASTER_PORT=18082
AGENTIC_NET_EXECUTOR_PORT=18084
AGENTIC_NET_VAULT_PORT=18085
AGENTIC_NET_GATEWAY_PORT=18083
AGENTIC_NET_GUI_PORT=14200
