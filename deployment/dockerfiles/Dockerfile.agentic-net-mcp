# Multi-stage Dockerfile for agentic-net-mcp (@agenticnets/mcp)
# Build context: project root (mcp depends on "file:../agentic-net-cli")

FROM node:22-alpine AS builder

WORKDIR /build

# Copy CLI workspace dependency first (for npm install resolution)
COPY agentic-net-cli/ ./agentic-net-cli/

# Copy mcp package files for dependency caching
COPY agentic-net-mcp/package*.json ./agentic-net-mcp/

# Install all dependencies (including devDependencies for tsup build)
WORKDIR /build/agentic-net-mcp
RUN npm install

# Copy mcp source code
COPY agentic-net-mcp/ ./

# Build — tsup bundles @agenticos/cli inline via noExternal
RUN npx tsup

# ---

FROM node:22-alpine AS runtime

# Create non-root user
RUN addgroup -S agenticnet && adduser -S -G agenticnet agenticnet

WORKDIR /app

# Copy package files and install production dependencies only
# (excludes @agenticos/cli since it's bundled inline)
COPY agentic-net-mcp/package*.json ./
RUN npm install --omit=dev --ignore-scripts 2>/dev/null || true

# Copy built output from builder
COPY --from=builder /build/agentic-net-mcp/dist ./dist

RUN chown -R agenticnet:agenticnet /app

USER agenticnet

# Streamable-HTTP MCP endpoint (containers can't do stdio to a remote client)
ENV AGENTICOS_MCP_TRANSPORT=http
EXPOSE 8091

ENTRYPOINT ["node", "dist/bin/agenticnets-mcp.js"]
