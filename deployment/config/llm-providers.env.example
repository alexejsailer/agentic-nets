# Optional named provider instances referenced by llm-groups.json.
# Copy to llm-providers.env (gitignored). The compose master loads it automatically.
LLM_PROVIDERS_GLM4_TYPE=ollama
LLM_PROVIDERS_GLM4_BASE_URL=http://host.docker.internal:11434
LLM_PROVIDERS_GLM4_MODEL=glm-4.6
LLM_PROVIDERS_GLM4_LOW_MODEL=glm-4.6
LLM_PROVIDERS_GLM4_HIGH_MODEL=glm-5.2
LLM_PROVIDERS_GLM4_THINKING_MODEL=glm-5.2
LLM_PROVIDERS_GLM4_MODEL_TIER=medium
LLM_PROVIDERS_GLM4_LABEL=GLM4 host

# A decision model (answers the typed questions of kind:llm lanes only; reach it with a group,
# e.g. {"groups": {"jev": {"provider": "jev"}}}). BASE_URL defaults to TypeSafe's public endpoint.
# LLM_PROVIDERS_JEV_TYPE=typesafe
# LLM_PROVIDERS_JEV_API_KEY=
# LLM_PROVIDERS_JEV_MODEL=jev-1.13.0
# Any service speaking the canonical decision API: TYPE=decision-api, BASE_URL = its full
# evaluation endpoint, API_KEY optional (sent as a bearer token).
