{
  "id": "working-memory",
  "name": "Working memory",
  "description": "The second-brain setup: memory places wired into a navigable graph, plus a continuously-running LLM distiller that turns raw inbox captures into durable, self-contained notes within seconds of arrival. memory_write/memory_recall target these places by design.",
  "version": "0.1.0",
  "params": {
    "distillPrompt": {
      "description": "Instruction for the distiller",
      "default": "You maintain a personal working memory. Rewrite the following raw capture as ONE durable, self-contained note that will still make sense months from now: keep concrete facts, names, decisions and reasons; drop filler. Reply with only the note text. RAW CAPTURE: ${input.data.text}"
    }
  },
  "net": { "netId": "memory", "name": "Working Memory" },
  "places": [
    { "placeId": "p-mem-inbox", "label": "inbox (raw captures)", "x": 100, "y": 100 },
    { "placeId": "p-mem-notes", "label": "notes (distilled)", "x": 400, "y": 100 },
    { "placeId": "p-mem-decisions", "label": "decisions", "x": 700, "y": 40 },
    { "placeId": "p-mem-knowledge", "label": "knowledge", "x": 700, "y": 160 },
    { "placeId": "p-mem-archive", "label": "archive", "x": 400, "y": 240 }
  ],
  "transitions": [
    {
      "transitionId": "t-mem-distill",
      "label": "distill raw captures into notes",
      "x": 250,
      "y": 100,
      "agentId": "agentic-net-master",
      "start": true,
      "inscription": {
        "id": "t-mem-distill",
        "kind": "llm",
        "label": "distill raw captures into notes",
        "presets": {
          "input": { "placeId": "p-mem-inbox", "arcql": "FROM $ LIMIT 1", "take": "FIRST", "consume": true }
        },
        "postsets": { "out": { "placeId": "p-mem-notes", "capacity": 200 } },
        "action": { "type": "llm", "nl": "${distillPrompt}", "timeoutMs": 240000 },
        "emit": [{ "to": "out", "from": "@response.raw" }],
        "mode": "SINGLE"
      }
    },
    {
      "transitionId": "t-link-notes-decisions",
      "label": "notes ground decisions",
      "x": 550,
      "y": 60,
      "agentId": "agentic-net-master",
      "start": false,
      "inscription": {
        "id": "t-link-notes-decisions",
        "kind": "link",
        "label": "notes ground decisions",
        "presets": {
          "from": { "placeId": "p-mem-notes", "arcql": "FROM $ LIMIT 1", "take": "FIRST", "consume": false, "optional": true }
        },
        "postsets": { "to": { "placeId": "p-mem-decisions" } }
      }
    },
    {
      "transitionId": "t-link-notes-knowledge",
      "label": "notes feed knowledge",
      "x": 550,
      "y": 140,
      "agentId": "agentic-net-master",
      "start": false,
      "inscription": {
        "id": "t-link-notes-knowledge",
        "kind": "link",
        "label": "notes feed knowledge",
        "presets": {
          "from": { "placeId": "p-mem-notes", "arcql": "FROM $ LIMIT 1", "take": "FIRST", "consume": false, "optional": true }
        },
        "postsets": { "to": { "placeId": "p-mem-knowledge" } }
      }
    },
    {
      "transitionId": "t-link-notes-archive",
      "label": "notes age into archive",
      "x": 400,
      "y": 180,
      "agentId": "agentic-net-master",
      "start": false,
      "inscription": {
        "id": "t-link-notes-archive",
        "kind": "link",
        "label": "notes age into archive",
        "presets": {
          "from": { "placeId": "p-mem-notes", "arcql": "FROM $ LIMIT 1", "take": "FIRST", "consume": false, "optional": true }
        },
        "postsets": { "to": { "placeId": "p-mem-archive" } }
      }
    }
  ],
  "arcs": [
    { "arcId": "a-distill-in", "sourceId": "p-mem-inbox", "targetId": "t-mem-distill" },
    { "arcId": "a-distill-out", "sourceId": "t-mem-distill", "targetId": "p-mem-notes" },
    { "arcId": "a-lnd-in", "sourceId": "p-mem-notes", "targetId": "t-link-notes-decisions" },
    { "arcId": "a-lnd-out", "sourceId": "t-link-notes-decisions", "targetId": "p-mem-decisions" },
    { "arcId": "a-lnk-in", "sourceId": "p-mem-notes", "targetId": "t-link-notes-knowledge" },
    { "arcId": "a-lnk-out", "sourceId": "t-link-notes-knowledge", "targetId": "p-mem-knowledge" },
    { "arcId": "a-lna-in", "sourceId": "p-mem-notes", "targetId": "t-link-notes-archive" },
    { "arcId": "a-lna-out", "sourceId": "t-link-notes-archive", "targetId": "p-mem-archive" }
  ],
  "seedTokens": [
    {
      "placeId": "p-mem-knowledge",
      "name": "how-this-works",
      "data": {
        "kind": "memory",
        "text": "This model is a working memory. Raw captures go to p-mem-inbox (memory_write place:inbox) and are distilled into p-mem-notes automatically by t-mem-distill. Durable decisions belong in p-mem-decisions, long-lived facts in p-mem-knowledge. Use memory_recall to search and memory_graph to navigate.",
        "source": "template"
      }
    }
  ],
  "tags": ["starter", "memory"]
}
